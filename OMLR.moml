        </property>
        <property name="fspehi_nm" class="ptolemy.data.expr.Parameter" value="1549.3150284237724">
        </property>
        <property name="f0spt_thz" class="ptolemy.data.expr.Parameter" value="_dep((fspelo_thz + fspehi_thz) / 2.0)">
